# No credentials are required for core use.
# Set environment variables in your terminal; this app does not auto-load .env files.
PORT=4317
# Optional: defaults to ./data. Never commit real workspace data.
# CAREER_DATA_DIR=/absolute/path/to/private/data
# Optional provider key; read only by the local server.
# OPENAI_API_KEY=
# Optional supported web search API (otherwise keyless best-effort search).
# BRAVE_SEARCH_API_KEY=
# Optional absolute path to an owner-managed Tectonic executable.
# CAREER_TECTONIC_PATH=
