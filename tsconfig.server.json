  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true,
    "outDir": "dist/server", "rootDir": ".", "types": ["node"]
  },
  "include": ["server", "shared", "seed"]
}